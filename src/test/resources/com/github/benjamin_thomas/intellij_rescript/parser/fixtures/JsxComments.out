  PsiComment(LINE_COMMENT)('// Comments in every JSX position. The compiler accepts all of them, and the')
  PsiComment(LINE_COMMENT)('// parser needs no rule for any of them: both comment types are in')
  PsiComment(LINE_COMMENT)('// `getCommentTokens()`, so PsiBuilder skips them everywhere for free.')
  PsiComment(LINE_COMMENT)('//')
  PsiComment(LINE_COMMENT)('// A block comment records the state it was entered from and returns there. It')
  PsiComment(LINE_COMMENT)('// can do that with a plain field rather than one cloned state per JSX position,')
  PsiComment(LINE_COMMENT)('// because no rule inside the comment state emits a token — the whole comment is')
  PsiComment(LINE_COMMENT)('// consumed inside one `advance()`, so no restart can land inside one. Strings')
  PsiComment(LINE_COMMENT)('// and templates DO emit tokens mid-state, which is why they needed')
  PsiComment(LINE_COMMENT)('// IN_TAG_STRING / IN_CHILD_STRING clones and this does not.')
  PsiComment(LINE_COMMENT)('// The reported shape: a line comment documenting the next attribute.')
