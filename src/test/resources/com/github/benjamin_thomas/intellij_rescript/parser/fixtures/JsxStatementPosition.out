  PsiComment(LINE_COMMENT)('//')
  PsiComment(LINE_COMMENT)('// A `<` glued to a name is a tag once a line break separates it from the')
  PsiComment(LINE_COMMENT)('// previous significant token, and the comparison operator otherwise. bsc')
  PsiComment(LINE_COMMENT)('// agrees: `a<b` and `a <b` are comparisons, while `a` ⏎ `<b` is an element')
  PsiComment(LINE_COMMENT)('// (which bsc then rejects as unterminated).')
  PsiComment(LINE_COMMENT)('//')
  PsiComment(LINE_COMMENT)('// Without the line-break signal every element below lexes as comparison,')
