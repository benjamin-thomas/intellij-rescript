  PsiComment(LINE_COMMENT)('// JSX — a JSX element used as another element's attribute value.')
  PsiComment(LINE_COMMENT)('//')
  PsiComment(LINE_COMMENT)('// The shape `<Outer prop={<Inner attr="literal" />} />` used to defeat the')
  PsiComment(LINE_COMMENT)('// plugin's permissive parser: the `/` of the inner `/>` was lexed as the start')
  PsiComment(LINE_COMMENT)('// of a regex literal (a closing string / template / `}` wasn't treated as an')
  PsiComment(LINE_COMMENT)('// "expression end"), so the bogus regex swallowed the surrounding `/>` and `}`')
  PsiComment(LINE_COMMENT)('// and left the braces unbalanced — marking the whole file red in the project')
  PsiComment(LINE_COMMENT)('// tree, with no inline squiggle pointing at the cause.')
  PsiComment(LINE_COMMENT)('//')
  PsiComment(LINE_COMMENT)('// Open this file in the sandbox IDE (`manage/dev/runIde`) and confirm the file')
  PsiComment(LINE_COMMENT)('// and the project-tree node stay un-reddened. Covered by the parser fixtures')
